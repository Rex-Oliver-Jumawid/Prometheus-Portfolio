# Public runtime configuration; these values are bundled into browser code.
# Local API port must match [api].port in supabase/config.toml.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:59321

# After `pnpm db:start`, copy this project's Publishable key from the CLI output
# (or `pnpm exec supabase status`) into .env.local. Keys vary by local project.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted deployment: replace all three values with your app origin, Supabase
# project URL, and publishable key. Never put secret/service-role keys here.
# No service-role key or database connection string is required by this app.
